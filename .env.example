# Copy this file to .env and fill in your values. Never commit .env.
# You can fill in all keys at once; LLM_PROVIDER decides which one is used.

# ===== Which provider to use =====
# One of: gemini | groq | openrouter | openai_compat
LLM_PROVIDER=gemini

# ===== Gemini (key from Google AI Studio) =====
GEMINI_API_KEY=paste-your-key-here
# Example name only. Check with: uv run python scripts/list_models.py gemini
GEMINI_MODEL=gemini-2.5-flash

# ===== Groq (key from console.groq.com) =====
# Base URL is built in: https://api.groq.com/openai/v1
GROQ_API_KEY=
# Example name only. Check with: uv run python scripts/list_models.py groq
GROQ_MODEL=llama-3.3-70b-versatile

# ===== OpenRouter (key from openrouter.ai) =====
# Base URL is built in: https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Free models end in ":free". Example name only.
# Check with: uv run python scripts/list_models.py openrouter free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ===== Any other OpenAI-compatible endpoint (only if LLM_PROVIDER=openai_compat) =====
# NVIDIA NIM:  https://integrate.api.nvidia.com/v1
# Ollama:      http://localhost:11434/v1   (key can be any text, e.g. ollama)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ===== Fallback, timeout and retries =====
# LLM_PROVIDER is tried first, then these in order (only those with a key above).
LLM_FALLBACK_ORDER=gemini,groq,openrouter
# Give up on a single request after this many seconds.
LLM_TIMEOUT_SECONDS=30
# Quick retries per provider for temporary errors (429, 503, timeouts) before moving on.
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_SECONDS=2

# ===== DuckDB warehouse file (relative to the data_eng folder) =====
DUCKDB_PATH=data/warehouse.duckdb
